# ---------------------------------------------------------------------------
# Configuración de Ferretería La Panameña
# Copie este archivo como .env en la raíz del proyecto y ajuste los valores.
# El archivo .env NO debe subirse a Git.
# ---------------------------------------------------------------------------

# Servidor de la API
PORT=4000
NODE_ENV=development

# Orígenes permitidos para el frontend en desarrollo (separados por coma).
# En producción el backend sirve el frontend compilado; además, el propio
# origen del puerto PORT se admite automáticamente para los archivos estáticos.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Conexión a PostgreSQL
# 5433 es el puerto del clúster local que crean los scripts de este proyecto.
# Si usa el servicio PostgreSQL habitual, cambie a 5432.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ferreteria
DB_USER=ferreteria_app
DB_PASSWORD=cambie_esta_contrasena

# Ruta al ejecutable pg_dump. Si PostgreSQL está en el PATH puede dejarse vacío.
# Ejemplo Windows: C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
PG_DUMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# Ruta al ejecutable pg_restore (solo la usan los scripts de restauración).
PG_RESTORE_PATH=C:\Program Files\PostgreSQL\18\bin\pg_restore.exe

# Carpeta donde se guardan los respaldos. Relativa a la raíz o absoluta.
RESPALDO_DIR=backups

# Tamaño máximo del cuerpo JSON (por ejemplo 100kb)
BODY_LIMIT=100kb
