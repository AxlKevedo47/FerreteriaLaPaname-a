{
  "name": "ferreteria-la-panamena",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema local de catálogo de productos para Ferretería La Panameña",
  "scripts": {
    "instalar": "npm --prefix backend install && npm --prefix frontend install",
    "db:local:iniciar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 iniciar",
    "db:local:detener": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 detener",
    "db:local:estado": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-db.ps1 estado",
    "db:esquema": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aplicar-esquema.ps1",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "respaldo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/respaldo.ps1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
